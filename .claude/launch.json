{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "posting-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "posting:local"
      ],
      "port": 8787
    },
    {
      "name": "posting-manual",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "POSTING_MANUAL=1",
        "npm",
        "--prefix",
        "server",
        "run",
        "posting:local"
      ],
      "port": 8787
    },
    {
      "name": "reel-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_PHONES=0501234567",
        "N8N_REEL_WEBHOOK_URL=http://127.0.0.1:9/reel-promo",
        "npm",
        "--prefix",
        "server",
        "run",
        "local"
      ],
      "port": 8787
    }
  ]
}
