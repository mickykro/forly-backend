# Copy to server/.env and fill in. The server auto-loads this file on startup.
#   cp server/.env.example server/.env

# Public base URL of THIS server (no trailing slash). Baked into the photo
# URLs sent to n8n, so Seedance/Vision Tagger must be able to reach it.
# Local test with a tunnel:  cloudflared tunnel --url http://localhost:8787
# then paste the printed https URL here. On the VPS, use the public host.
BASE_URL=http://127.0.0.1:8787

# Local-dev only: proxy uploads to the production host so local test images get
# the SAME (production) URL and are fetchable by the real pipeline. The browser
# still uploads to your local server; it forwards the bytes to production, and
# the returned public_url points to production. Leave empty in production.
# REMOTE_UPLOAD_BASE=https://forly.srv1173890.hstgr.cloud

# n8n webhooks. WW1 = photos → video pipeline (the demo path).
N8N_WW1_WEBHOOK_URL=https://n8n.srv1173890.hstgr.cloud/webhook/dashboard-create
N8N_PIPELINE_WEBHOOK_URL=https://n8n.srv1173890.hstgr.cloud/webhook/property-page-builder

# Where finished landing pages are served (for the status link).
PAGE_BASE_URL=https://call4li-nadlan.web.app

# Optional: path to a Firebase service-account key to write listings to real
# Firestore (needed for the Property Page Builder step). Omit for in-memory.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# Agent auth: HMAC secret for session cookies + one-tap extend links. REQUIRED
# for login/OTP, dashboard, and signup routes — the server reads this exact
# name (server/index.js). Use a long random value (e.g. `openssl rand -hex 32`).
# Keep it stable, and identical to the Cloud Functions secret so both paths
# accept each other's session cookies.
# NADLAN_JWT_SECRET=

# Admin console (/admin.html) — comma-separated allowlist of phone numbers
# permitted to see & manage EVERY agent's properties. Any accepted phone form
# works (050-…, +972…, 972…); each is normalized the same way as a login.
# DENY-BY-DEFAULT: leave this unset and the admin panel refuses everyone.
# ADMIN_PHONES=972501112222,972544445555

# WhatsApp (Green-API) — REQUIRED for OTP delivery and agent/lead notifications.
# GREENAPI_INSTANCE=
# GREENAPI_TOKEN=

# n8n Leads Handler webhook (prospect funnel). Optional.
# N8N_LEAD_WEBHOOK_URL=

# Room-name labels on /api/video-overlay (optional). When set and the caller
# passes `rooms`, sampled frames of the finished video are classified with a
# Claude vision call, and the Hebrew room name — plus a short 1-2 word
# descriptor of that frame — is burned bottom-right over a cream gradient on
# the segments where that room is on screen. Unset = titles only, no vision call.
# ANTHROPIC_API_KEY=
# OVERLAY_VISION_MODEL=claude-haiku-4-5-20251001

# Music bed on /api/video-overlay. Seedance clips are generated silent, so one
# track is laid over the whole stitched video. With FAL_KEY set, a bed is
# generated per video at exactly the stitched length (~$0.02 per output minute,
# so roughly $0.01 for a 30s walkthrough). Generation is best-effort: on failure
# the server falls back to OVERLAY_MUSIC_PATH, then to a silent video. Callers
# can also pass music_url (use this exact track) or music_prompt (tailor the
# generation for one listing) in the request body.
# FAL_KEY=
# Model id is case-sensitive in the URL path. Any fal model taking
# {prompt, duration} and returning a file works here.
# OVERLAY_MUSIC_MODEL=CassetteAI/music-generator
# OVERLAY_MUSIC_PROMPT=
# Static fallback track. Defaults to server/assets/music/default.m4a.
# OVERLAY_MUSIC_PATH=/opt/forly/music/bed.m4a

# Content distribution (Meta Graph API) — required only when distribution is on.
# App credentials from developers.facebook.com (see docs/distribution/META-APP-SETUP.md).
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URL=https://<host>/api/distribution/oauth/callback
# META_GRAPH_VERSION=v21.0
# Kill switch: absent ⇒ on. Set to false to stop ALL posting immediately.
# DISTRIBUTION_ENABLED=
# Narrow the OAuth scopes while the Meta app lacks some permissions (e.g. the
# Instagram pair before its use case is added). Absent ⇒ the full default list.
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
